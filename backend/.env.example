# ── Backend environment variables ─────────────────────────────────────────────
# Copy this file to .env and fill in real values before running the server.
# Never commit .env to source control.

# ── MongoDB (existing layer — do not remove) ───────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── JWT auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string

# ── Supabase (new parallel layer) ─────────────────────────────────────────────
# Find these in: Supabase dashboard → Project Settings → API
SUPABASE_URL=https://<your-project-ref>.supabase.co
# service_role key — bypasses RLS, backend-only, never expose to browser
SUPABASE_SERVICE_KEY=<service_role_key>
