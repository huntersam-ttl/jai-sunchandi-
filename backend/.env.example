# Backend environment — copy to backend/.env and fill in. NEVER commit the real .env.

# --- Runtime ---
ENVIRONMENT=development            # development | production

# --- Supabase (backend-only secrets) ---
SUPABASE_URL=
# BACKEND ONLY — full-access key. NEVER expose to the frontend / browser.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string for SQLAlchemy/asyncpg. BACKEND ONLY.
SUPABASE_DB_URL=
# Used to verify Supabase-issued admin JWTs on protected routes.
SUPABASE_JWT_SECRET=

# --- Admin (seeded once in Supabase Auth; see S3) ---
ADMIN_EMAIL=

# --- CORS ---
# Comma-separated allowed browser origins. No wildcard in production.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
