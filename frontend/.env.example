# Frontend environment — copy to frontend/.env. NEVER commit the real .env.
# Only PUBLIC values belong here: the anon key is safe for the browser.
# NEVER put SUPABASE_SERVICE_ROLE_KEY or SUPABASE_DB_URL in the frontend.

# FastAPI backend origin (the app appends "/api").
REACT_APP_BACKEND_URL=http://localhost:8000

# --- Supabase (public/anon only) ---
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
